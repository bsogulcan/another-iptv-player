<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Hardened Runtime + ad-hoc imza altında dyld custom framework'lere
	     Team ID match şartı koyuyor (libmpv vendored). Library validation'ı
	     kapatmak custom .framework'lerin yüklenmesine izin verir. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
	<!-- iCloud sync backend (Models/CloudKitSyncTransport.swift) — an alternate
	     to the self-hosted server, mutually exclusive with it. The SAME
	     container identifier must be used on the iOS and tvOS targets too,
	     or each platform's devices end up in unrelated containers and never
	     see each other's data. -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.dev.another-iptv-player.sync</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
</dict>
</plist>
