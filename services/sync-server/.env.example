# Copy to .env and adjust before running with docker compose.

# Port the server listens on inside the container.
PORT=8787

# Where the SQLite database file lives. Mounted as a volume in docker-compose.yml.
DATA_DIR=/data

# Secret used to derive device-token hashes (HMAC key). Generate one with:
#   openssl rand -hex 32
# Required in production; changing it invalidates all issued device tokens.
TOKEN_PEPPER=changeme-generate-a-long-random-secret

# Allow new accounts to self-register via POST /api/auth/register.
# Set to "false" once you (and anyone you're hosting this for) have accounts.
ALLOW_REGISTRATION=true

# Comma-free single origin, or "*" to allow any client origin.
CORS_ORIGIN=*

# Safety cap on how many sync items a single push request may contain.
MAX_SYNC_ITEMS_PER_PUSH=500
